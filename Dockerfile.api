# ------------------------------------------------------------------------------
# Production Dockerfile for DairyOS Express & Prisma API Server
# ------------------------------------------------------------------------------
FROM node:20-alpine AS api-builder

WORKDIR /app

# Install OpenSSL for Prisma ORM
RUN apk add --no-cache openssl

COPY package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

COPY prisma ./prisma
RUN npx prisma generate

COPY server ./server
COPY tsconfig.json ./

# ------------------------------------------------------------------------------
# Production Runner
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

RUN apk add --no-cache openssl curl

ENV NODE_ENV=production
ENV PORT=5000

COPY --from=api-builder /app/node_modules ./node_modules
COPY --from=api-builder /app/package*.json ./
COPY --from=api-builder /app/prisma ./prisma
COPY --from=api-builder /app/server ./server
COPY --from=api-builder /app/tsconfig.json ./

EXPOSE 5000

# Healthcheck for container orchestration
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5000/healthz || exit 1

# Start server using tsx
CMD ["npx", "tsx", "server/src/index.ts"]
