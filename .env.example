# ========================================================
# DairyOS Enterprise ERP - Environment Configuration
# ========================================================

# Server Port
PORT=5000

# Database Connection (SQLite local development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL production, uncomment:
# DATABASE_URL="postgresql://dairyos:dairyos_secure_password_2026@localhost:5432/dairyos_production?schema=public"

# JSON Web Token Secret
JWT_SECRET="dairyos-super-secret-production-key-2026"

# Google Gemini AI API Key (Optional for cloud generative AI features)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=""
