# ========================================================
# DairyOS Enterprise ERP - Environment Configuration
# ========================================================

# Server Port
PORT=5000

# Database Connection (SQLite local development)
DATABASE_URL="file:./local.db"

# Cloud MongoDB Connection (Optional: for MongoDB Atlas cloud database)
# Obtain free cluster URI from https://www.mongodb.com/atlas
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/dairyos?retryWrites=true&w=majority"

# Local session secret. Generate a unique value with: openssl rand -hex 32
JWT_SECRET=""

# Optional, local-only seed password. Demo accounts are not created without this value.
SEED_DEMO_PASSWORD=""

# Leave disabled unless a developer explicitly enables demo role switching.
DEMO_AUTH_ENABLED="false"
VITE_ENABLE_DEMO_AUTH="false"

# Comma-separated browser origins allowed to make credentialed cross-origin API calls.
CORS_ORIGINS=""

# Google Gemini AI API Key (Optional for cloud generative AI features)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=""

# Optional Live Notifications & Gateway Integrations
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
PAYMENT_WEBHOOK_SECRET=""

