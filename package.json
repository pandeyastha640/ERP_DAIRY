{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run server\" \"npm run dev\"",
    "studio": "prisma studio --port 5555 --browser none",
    "seed": "tsx prisma/seed.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "db:export": "tsx scripts/export_data.ts",
    "db:mongo:start": "tsx scripts/start_local_mongodb.ts",
    "db:mongo:import": "tsx scripts/import_to_mongodb.ts",
    "db:mongo:view": "tsx scripts/inspect_mongodb.ts",
    "test:phases": "tsx scripts/verify_all_phases.ts",
    "launch:check": "tsx scripts/preflight_launch_check.ts"
  },


  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
