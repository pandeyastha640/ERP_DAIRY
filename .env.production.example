# ==============================================================================
# DairyOS Enterprise ERP - Production Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000

# PostgreSQL 16 Enterprise Production Database
DATABASE_URL="postgresql://dairy_admin:secure_dairy_pass_2026@localhost:5432/dairyos_prod?schema=public"

# MongoDB Atlas Enterprise Cloud Database (Optional dual-store)
# MONGODB_URI="mongodb+srv://dairy_admin:<password>@cluster0.mongodb.net/dairyos_prod?retryWrites=true&w=majority"

# Redis 7 In-Memory Telemetry Cache

REDIS_URL="redis://localhost:6379"

# Security & JSON Web Tokens
JWT_SECRET="dairyos_enterprise_super_secret_jwt_key_2026"
SESSION_EXPIRY_HOURS=24

# Google Gemini 2.5 Flash SDK Integration (Optional, fallback heuristic enabled)
GEMINI_API_KEY=""

# Hardware Serial & IoT Bridge Defaults
DEFAULT_LACTOSCAN_BAUD=9600
DEFAULT_INTAKE_TANK=TANK-B

# Bank Payout Gateway Configuration (RazorpayX / Cashfree IMPS)
BANK_PAYOUT_MODE="SIMULATION" # Set to LIVE for direct banking API webhooks
BANK_API_KEY=""
BANK_API_SECRET=""
